<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<noWarn>1591</noWarn>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>FTELSRCore</RootNamespace>
		<PackageId>FTELSRCore.Shared</PackageId>
		<Authors>nguyendqk</Authors>
		<Company>FPT TELECOM</Company>
		<Product>FTELSRCore.Shared</Product>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Asp.Versioning.Mvc" Version="8.1.1" />
		<PackageReference Include="StackExchange.Redis" Version="3.1.13" />
		<PackageReference Include="ZiggyCreatures.FusionCache" Version="2.6.0" />
		<PackageReference Include="Polly" Version="8.7.0" />
		<PackageReference Include="MongoDB.Bson" Version="3.10.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="MongoDB.Driver" Version="3.10.0" />
		<PackageReference Include="FluentValidation" Version="12.1.1" />
		<PackageReference Include="MediatR" Version="12.4.1" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Confluent.Kafka" Version="2.15.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.18" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.18" />
		<PackageReference Include="Serilog.Sinks.PeriodicBatching" Version="5.0.0" />
		<PackageReference Include="Dapper" Version="2.1.79" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
		<PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.2.3" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.18" />
		<PackageReference Include="OpenTelemetry" Version="1.17.0" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
		<PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.17.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
		<PackageReference Include="ZiggyCreatures.FusionCache.OpenTelemetry" Version="2.6.0" />
	</ItemGroup>

	<Target Name="CopyToOtherLibs" AfterTargets="Build">
		<ItemGroup>
			<FilesToCopy Include="$(OutputPath)**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(FilesToCopy)" DestinationFolder="..\..\sr-hub-api\Libs\" />
		<Copy SourceFiles="@(FilesToCopy)" DestinationFolder="..\..\sr-request-api\Libs\" />
		<Copy SourceFiles="@(FilesToCopy)" DestinationFolder="..\..\sr-workflow-api\Libs\" />
		<Copy SourceFiles="@(FilesToCopy)" DestinationFolder="..\..\sr-gateway-api\Libs\" />
		<Copy SourceFiles="@(FilesToCopy)" DestinationFolder="..\..\sr-owner-api\Libs" />
		<Copy SourceFiles="@(FilesToCopy)" DestinationFolder="..\..\sr-distribution-api\Libs\" />
		<Copy SourceFiles="@(FilesToCopy)" DestinationFolder="..\..\sr-ticket-service-delivery-api\Libs\" />
		<Copy SourceFiles="@(FilesToCopy)" DestinationFolder="..\..\sr-ticket-finance-management-api\Libs\" />
		<Copy SourceFiles="@(FilesToCopy)" DestinationFolder="..\..\sr-ticket-customer-experience-api\Libs\" />
		<Copy SourceFiles="@(FilesToCopy)" DestinationFolder="..\..\sr-ticket-decision-adjustment-api\Libs\" />
	</Target>

</Project>
